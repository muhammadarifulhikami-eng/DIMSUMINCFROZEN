# Server
PORT=3000
NODE_ENV=production
ALLOWED_ORIGIN=http://localhost:3000

# Lokasi Toko Dimsum Inc Frozen (untuk kalkulasi jarak Gojek/Grab)
STORE_NAME="Dimsum Inc Frozen Official"
STORE_LAT=-6.2615
STORE_LNG=106.8106
STORE_POSTAL_CODE=12730

# Biteship API (Opsional - untuk tarif real-time Gojek & Grab Instant/SameDay)
# Daftar di https://biteship.com
BITESHIP_API_KEY=

# Payment Gateway QRIS (Pilih salah satu atau kosongkan untuk Mode Sandbox)
# Midtrans Core API / Snap
PAYMENT_PROVIDER=sandbox
MIDTRANS_SERVER_KEY=
MIDTRANS_IS_PRODUCTION=false

# Webhook & Session Secrets (gunakan string acak minimal 32 karakter)
WEBHOOK_SECRET=ganti_dengan_secret_acak_minimal_32_karakter
SESSION_SECRET=ganti_dengan_session_secret_minimal_32_karakter

# Google OAuth Client ID (Opsional - untuk Login/Register via Google Sign-In)
GOOGLE_CLIENT_ID=
